---
import '../styles/global.css';
import { site } from '../lib/content';
import { url, media } from '../lib/paths';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const { title, description = site.tagline, image = site.socialImage, type = 'website', noindex = false } = Astro.props;
const fullTitle = title ? `${title} · ${site.title}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(media(image)!, Astro.site).href : undefined;
const path = Astro.url.pathname.replace(/\/+$/, '');
const nav = [
  { href: url('/'), label: 'Home' },
  { href: url('team/'), label: 'Team' },
  { href: url('story/'), label: 'Story' },
  { href: url('projects/'), label: 'Projects' },
];
const isCurrent = (href: string) => {
  const h = href.replace(/\/+$/, '');
  return h === url('').replace(/\/+$/, '') ? path === h : path.startsWith(h);
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={site.title} href={url('feed.xml')} />
    <slot name="head" />
    <meta property="og:title" content={title ?? site.title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,500;8..60,600;8..60,700&family=JetBrains+Mono&display=swap"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={url('/')}>{site.title}</a>
        <nav class="nav" aria-label="Main">
          {nav.map((n) => <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <span>{site.title}: {site.tagline}</span>
        <span>
          <a href={url('feed.xml')}>RSS</a> · <a href={url('story/feed.xml')}>Story RSS</a> ·
          <a href={site.github.orgUrl}>GitHub</a>
        </span>
      </div>
    </footer>
  </body>
</html>
