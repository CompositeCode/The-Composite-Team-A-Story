---
import { media } from '../lib/paths';
interface Props { src?: string; name: string; size?: number; }
const { src, name, size = 56 } = Astro.props;
const initials = name.split(/\s+/).map((w) => w[0]).join('').slice(0, 2).toUpperCase();
---
{src ? (
  <img class="avatar" src={media(src)} alt={`${name}'s avatar`} width={size} height={size} style={`width:${size}px;height:${size}px`} loading="lazy" />
) : (
  <span class="avatar" aria-hidden="true" style={`width:${size}px;height:${size}px;display:grid;place-items:center;font-weight:700;font-size:${size / 2.6}px;color:var(--muted)`}>{initials}</span>
)}
